# Порт приложения (наружу не публиковать, только через Caddy/cloudflared)
PORT=8787

# Каталог с данными: accounts.json и enc.key
DATA_DIR=./data

# Как часто опрашивать Google Calendar, мс
POLL_INTERVAL_MS=30000

# Сколько дней аккаунт может не синхронизироваться из расширения, прежде чем сервер
# удалит его вместе с refresh token и токенами каналов. 0 — никогда не удалять.
ACCOUNT_TTL_DAYS=30

# 1 — разрешить работу по http (только для локальной отладки)
ALLOW_HTTP=0

# 1 — писать строку на каждый запрос
LOG_REQUESTS=0
